        "jsCode": "async function checkDuplicate() {\n  try {\n    const input = $input.all()[0]?.json;\n    if (!input) return [];\n    \n    const deliveryId = input.delivery_id || input.order_id || input.id;\n    if (!deliveryId) return $input.all();\n    \n    const sheetData = await $node['Log to Google Sheets'].getSheetData({\n      range: 'A2:A',\n      headerRow: false\n    });\n    \n    const exists = sheetData.some(row => row[0]?.toString() === deliveryId.toString());\n    return exists ? [] : $input.all();\n  } catch (error) {\n    console.error('Duplicate check failed:', error);\n    return $input.all();\n  }\n}\nreturn checkDuplicate();"
      },
